{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "le01aout",
  "account_id": "47044f09c35565ef930da6627bc7ae60",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Workers Logs: /api/fiche-client and /api/wa-facture log each card / send (dashboard → Workers → le01aout → Logs).
  // redact_query_string keeps WA_HOOK_KEY (/api/wa-facture?key=…) out of the logs; any deploy without it resets it to false.
  "observability": { "enabled": true, "redact_query_string": true }
}
